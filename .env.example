# Backend. All optional for local development.
# Tiger Cloud: set the three role URLs (and ADMIN_DB_URL for reset/seed).
ADMIN_DB_URL=
APP_DB_URL=
RELEASE_DB_URL=
PUBLISHED_DB_URL=
# Paid AI Studio key. Leave empty to use template summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COHORT_HASH_SALT=change-me
CORS_ORIGINS=http://localhost:3000
# dev = demo logins only, firebase = real sign-in only, both = either
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# Web (web/.env.local)
NEXT_PUBLIC_NURSE_API=http://localhost:8001
NEXT_PUBLIC_MANAGER_API=http://localhost:8002
